HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://wastenot:replace-local-db-password@127.0.0.1:5432/wastenot?sslmode=disable
# Generate: openssl rand -base64 32 (never commit the value).
JWT_SECRET_BASE64=
# For compose, set this to the same local-only password used in DATABASE_URL.
POSTGRES_PASSWORD=
AI_ENABLED=false
# Set false to deploy real scanning while Gemini/reviewed guides are not ready.
AI_RECOMMENDATION_ENABLED=false
AI_ALLOW_PROTOTYPE=false
AI_DETECTION_URL=http://127.0.0.1:8091
AI_RECOMMENDATION_URL=http://127.0.0.1:8093
AI_SERVICE_TOKEN=
AI_RECOMMENDATION_TOKEN=
# Optional: set to a writable private directory to enable /v1/photos attachments (capabilities.photos=true).
PHOTO_STORAGE_DIR=
# Local development only: serves Swagger UI at /swagger/index.html. Keep false on the VM.
SWAGGER_ENABLED=false
