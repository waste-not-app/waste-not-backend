{
  "components": {
    "schemas": {
      "CatalogItem": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "guide_status": {
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "UNAVAILABLE"
            ],
