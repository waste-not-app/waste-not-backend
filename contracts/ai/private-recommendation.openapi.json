            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "object_key": {
            "title": "Object Key",
            "type": "string"
          },
          "special_handling": {
            "title": "Special Handling",
            "type": "boolean"
          }
        },
        "required": [
          "object_key",
          "label",
          "category",
          "special_handling",
          "guide_status"
