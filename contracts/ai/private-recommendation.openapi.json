          "ORGANIC",
          "PLASTIC",
          "PAPER",
          "GLASS",
          "METAL",
          "ELECTRONIC",
          "OTHER"
        ],
        "title": "Category",
        "type": "string"
      },
      "Condition": {
        "additionalProperties": false,
        "properties": {
          "cleanable": {
            "default": "UNKNOWN",
            "enum": [
              "YES",
              "NO",
              "UNKNOWN"
            ],
            "title": "Cleanable",
            "type": "string"
          },
          "cleanliness": {
            "default": "UNKNOWN",
            "enum": [
              "CLEAN",
              "DIRTY",
              "UNKNOWN"
            ],
            "title": "Cleanliness",
            "type": "string"
          },
          "former_contents": {
            "default": "UNKNOWN",
            "enum": [
              "FOOD_DRINK",
              "CHEMICAL",
              "OTHER",
              "UNKNOWN"
            ],
            "title": "Former Contents",
            "type": "string"
          },
          "integrity": {
            "default": "UNKNOWN",
            "enum": [
              "INTACT",
              "DAMAGED",
              "UNKNOWN"
            ],
            "title": "Integrity",
            "type": "string"
          },
          "reusable": {
            "default": "UNKNOWN",
            "enum": [
              "YES",
              "NO",
              "UNKNOWN"
            ],
            "title": "Reusable",
            "type": "string"
          },
          "soiling": {
            "default": "UNKNOWN",
            "enum": [
              "FOOD_DRINK",
              "DUST",
              "HAZARDOUS",
              "UNKNOWN"
            ],
            "title": "Soiling",
            "type": "string"
          }
        },
        "title": "Condition",
        "type": "object"
      },
      "Context": {
        "additionalProperties": false,
        "properties": {
          "allow_conditional": {
            "default": true,
            "title": "Allow Conditional",
            "type": "boolean"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "condition": {
            "$ref": "#/components/schemas/Condition",
            "default": {
              "cleanable": "UNKNOWN",
              "cleanliness": "UNKNOWN",
              "former_contents": "UNKNOWN",
              "integrity": "UNKNOWN",
              "reusable": "UNKNOWN",
              "soiling": "UNKNOWN"
            }
          },
          "object_key": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Object Key",
            "type": "string"
          },
          "recommendation_goal": {
            "default": "AUTO",
            "enum": [
              "AUTO",
              "PREVENTION",
              "HANDLING"
            ],
            "title": "Recommendation Goal",
            "type": "string"
          },
          "recycling_access": {
            "default": "UNKNOWN",
            "enum": [
              "YES",
              "NO",
              "UNKNOWN"
            ],
            "title": "Recycling Access",
            "type": "string"
          },
          "reuse_intention": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reuse Intention"
          },
          "risk_flag": {
            "default": false,
            "title": "Risk Flag",
            "type": "boolean"
          },
          "risk_type": {
            "default": "UNKNOWN",
            "enum": [
              "UNKNOWN",
              "SHARP",
              "CHEMICAL",
              "BIOLOGICAL",
              "ELECTRICAL",
              "OTHER"
            ],
            "title": "Risk Type",
            "type": "string"
          }
        },
        "required": [
          "object_key",
          "category"
        ],
        "title": "Context",
        "type": "object"
      },
      "DecisionInput": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "selection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TrustedSelection"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "context"
        ],
        "title": "DecisionInput",
        "type": "object"
      },
      "Envelope_ObjectCatalog_": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Api Version",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ObjectCatalog"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "data"
        ],
        "title": "Envelope[ObjectCatalog]",
        "type": "object"
      },
      "Envelope_RecommendationResult_": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Api Version",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/RecommendationResult"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "data"
        ],
        "title": "Envelope[RecommendationResult]",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "AI_BUSY",
              "AI_DISABLED",
              "AI_SESSION_EXPIRED",
              "AI_TIMEOUT",
              "AI_UNAVAILABLE",
              "DETECTION_NOT_FOUND",
              "FILE_TOO_LARGE",
              "IDEMPOTENCY_CONFLICT",
              "IMAGE_DIMENSIONS_EXCEEDED",
              "INVALID_AI_REFERENCE",
              "INVALID_AI_RESPONSE",
              "INVALID_CONTEXT",
              "INVALID_IMAGE",
              "METHOD_NOT_ALLOWED",
              "NOT_FOUND",
              "OBJECT_REQUIRES_MANUAL",
              "RATE_LIMITED",
              "REQUEST_TOO_LARGE",
              "UNAUTHENTICATED",
              "UNSUPPORTED_MEDIA_TYPE",
              "VALIDATION_ERROR"
            ],
            "title": "Code",
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Fields",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Api Version",
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "GuideReference": {
        "additionalProperties": false,
        "properties": {
          "guide_id": {
            "minLength": 1,
            "title": "Guide Id",
            "type": "string"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "guide_id",
          "version"
        ],
        "title": "GuideReference",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ObjectCatalog": {
        "additionalProperties": false,
        "properties": {
          "catalog_version": {
            "title": "Catalog Version",
            "type": "string"
          },
          "class_thresholds": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Thresholds"
            },
            "title": "Class Thresholds",
            "type": "object"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CatalogItem"
            },
            "title": "Items",
            "type": "array"
          },
          "mapping_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mapping Version"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "review_only_classes": {
            "items": {
              "type": "string"
            },
            "title": "Review Only Classes",
            "type": "array"
          },
          "review_profile": {
            "default": "catalog-default-01",
            "title": "Review Profile",
            "type": "string"
          },
          "supported_object_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Supported Object Labels",
            "type": "object"
          },
          "supported_visual_classes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supported Visual Classes"
          }
        },
        "required": [
          "catalog_version",
          "items"
        ],
        "title": "ObjectCatalog",
        "type": "object"
      },
      "RawDetection": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              }
            ],
            "title": "Bbox",
            "type": "array"
          },
          "class_id": {
            "minimum": 0.0,
            "title": "Class Id",
            "type": "integer"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "raw_class": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Raw Class",
            "type": "string"
          }
        },
        "required": [
          "class_id",
          "raw_class",
          "confidence",
          "bbox"
        ],
        "title": "RawDetection",
        "type": "object"
      },
      "RecommendationResult": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "properties": {
                "conditions_to_verify": {
                  "maxItems": 0
                },
                "recommendation_basis": {
                  "type": "null"
                },
                "recommendation_scope": {
                  "type": "null"
                },
                "recommended_method": {
                  "type": "null"
                }
              }
            },
            "if": {
              "properties": {
                "status": {
                  "const": "READY"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                },
                "recommendation_basis": {
                  "enum": [
                    "CONFIRMED",
                    "CONDITIONAL"
                  ]
                },
                "recommendation_scope": {
                  "enum": [
                    "PREVENTION",
                    "HANDLING"
                  ]
                },
                "recommended_method": {
                  "enum": [
                    "REDUCE",
                    "REUSE",
                    "RECYCLE",
                    "TRASH"
                  ]
                },
                "source_urls": {
                  "minItems": 1
                }
              },
              "required": [
                "recommended_method",
                "recommendation_scope",
                "evidence_ids",
                "source_urls",
                "recommendation_basis"
              ]
            }
          },
          {
            "else": {
              "properties": {
                "missing_context": {
                  "maxItems": 0
                }
              }
            },
            "if": {
              "properties": {
                "status": {
                  "const": "NEEDS_CONTEXT"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "missing_context": {
                  "minItems": 1
                }
              },
              "required": [
                "missing_context"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "recommended_method": {
                  "const": "REDUCE"
                },
                "status": {
                  "const": "READY"
                }
              },
              "required": [
                "status",
                "recommended_method"
              ]
            },
            "then": {
              "properties": {
                "recommendation_scope": {
                  "const": "PREVENTION"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "recommended_method": {
                  "enum": [
                    "REUSE",
                    "RECYCLE",
                    "TRASH"
                  ]
                },
                "status": {
                  "const": "READY"
                }
              },
              "required": [
                "status",
                "recommended_method"
              ]
            },
            "then": {
              "properties": {
                "recommendation_scope": {
                  "const": "HANDLING"
                }
              }
            }
          },
          {
            "else": {
              "properties": {
                "conditions_to_verify": {
                  "maxItems": 0
                }
              }
            },
            "if": {
              "properties": {
                "recommendation_basis": {
                  "const": "CONDITIONAL"
                }
              },
              "required": [
                "recommendation_basis"
              ]
            },
            "then": {
              "properties": {
                "conditions_to_verify": {
                  "minItems": 1
                },
                "status": {
                  "const": "READY"
                }
              },
              "required": [
                "conditions_to_verify"
              ]
            }
          }
        ],
        "properties": {
          "caution": {
            "default": "",
            "title": "Caution",
            "type": "string"
          },
          "conditions_to_verify": {
            "items": {
              "enum": [
                "condition.cleanliness",
                "condition.integrity",
                "condition.reusable",
                "condition.cleanable",
                "condition.soiling",
                "condition.former_contents",
                "reuse_intention",
                "recycling_access",
                "risk_type"
              ],
              "type": "string"
            },
            "title": "Conditions To Verify",
            "type": "array"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "guide_refs": {
            "items": {
              "$ref": "#/components/schemas/GuideReference"
            },
            "title": "Guide Refs",
            "type": "array"
          },
          "missing_context": {
            "items": {
              "enum": [
                "condition.cleanliness",
                "condition.integrity",
                "condition.reusable",
                "condition.cleanable",
                "condition.soiling",
                "condition.former_contents",
                "reuse_intention",
                "recycling_access",
                "risk_type"
              ],
              "type": "string"
            },
            "title": "Missing Context",
            "type": "array"
          },
          "prototype_only": {
            "title": "Prototype Only",
            "type": "boolean"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          },
          "recommendation_basis": {
            "anyOf": [
              {
                "enum": [
                  "CONFIRMED",
                  "CONDITIONAL"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Basis"
          },
          "recommendation_scope": {
            "anyOf": [
              {
                "enum": [
                  "PREVENTION",
                  "HANDLING"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Scope"
          },
          "recommendation_version": {
            "default": "pilot-policy-06",
            "title": "Recommendation Version",
            "type": "string"
          },
          "recommended_method": {
            "anyOf": [
              {
                "enum": [
                  "REDUCE",
                  "REUSE",
                  "RECYCLE",
                  "TRASH"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommended Method"
          },
          "source_details": {
            "items": {
              "$ref": "#/components/schemas/SourceReference"
            },
            "title": "Source Details",
            "type": "array"
          },
          "source_urls": {
            "items": {
              "type": "string"
            },
            "title": "Source Urls",
            "type": "array"
          },
          "special_handling": {
            "default": false,
            "title": "Special Handling",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "READY",
              "NEEDS_CONTEXT",
              "UNAVAILABLE"
            ],
            "title": "Status",
            "type": "string"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "status",
          "reason",
          "provider",
          "prototype_only"
        ],
        "title": "RecommendationResult",
        "type": "object"
      },
      "SourceReference": {
        "additionalProperties": false,
        "properties": {
          "checked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checked At"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "region": {
            "title": "Region",
            "type": "string"
          },
          "scope_note": {
            "title": "Scope Note",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title",
          "publisher",
          "region",
          "checked_at",
          "scope_note"
        ],
        "title": "SourceReference",
        "type": "object"
      },
      "Thresholds": {
        "additionalProperties": false,
        "properties": {
          "lower": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Lower",
            "type": "number"
          },
          "offered": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Offered",
            "type": "number"
          }
        },
        "required": [
          "lower",
          "offered"
        ],
        "title": "Thresholds",
        "type": "object"
      },
      "TrustedSelection": {
        "additionalProperties": false,
        "description": "Go constructs this from its stored Python result, never from a public body.",
        "properties": {
          "class_names": {
            "items": {
              "type": "string"
            },
            "maxItems": 256,
            "minItems": 1,
            "title": "Class Names",
            "type": "array"
          },
          "mapping_version": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Mapping Version",
            "type": "string"
          },
          "model_sha256": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Sha256"
          },
          "model_version": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Model Version",
            "type": "string"
          },
          "object": {
            "$ref": "#/components/schemas/RawDetection"
          }
        },
        "required": [
          "model_version",
          "mapping_version",
          "class_names",
          "object"
        ],
        "title": "TrustedSelection",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "description": "Private Go-to-Python credential; never send to Android",
        "scheme": "bearer",
        "type": "http"
      },
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "WasteNot private AI decisions",
    "version": "1.0.0",
    "x-api-version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "AI error; see errors.json"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
